        {
          "id": "53ab96a5-05e7-4da8-b408-090e6bd19f05",
          "name": "List files with optional app and action filters",
          "request": {
            "name": "List files with optional app and action filters",
            "description": {
              "content": "Retrieves a list of files associated with the authenticated project. Results can be filtered by toolkit and tool slugs.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v3",
                "files",
                "list"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "toolkit_slug",
                  "value": "<string>",
                  "description": "Filter files by app slug. Example: \"file-converter\""
                },
                {
                  "disabled": false,
                  "key": "tool_slug",
                  "value": "<string>",
                  "description": "Filter files by action slug. Example: \"convert-to-pdf\""
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<number>",
                  "description": "Number of items per page, max allowed is 1000"
                },
                {
                  "disabled": false,
                  "key": "cursor",
                  "value": "<string>",
                  "description": "Cursor for pagination. The cursor is a base64 encoded string of the page and limit. The page is the page number and the limit is the number of items per page. The cursor is used to paginate through the items. The cursor is not required for the first page."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "x-api-key"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
          },
