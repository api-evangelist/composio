{
  "opencollection": "1.0.0",
  "info": {
    "name": "Composio Platform Account Management Webhook Subscriptions API",
    "version": "3.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Webhook Subscriptions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List webhook subscriptions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://backend.composio.dev/api/v3/webhook_subscriptions",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of items per page, max allowed is 1000"
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Cursor for pagination. The cursor is a base64 encoded string of the page and limit. The page is the page number and the limit is the number of items per page. The cursor is used to paginate through the items. The cursor is not required for the first page."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Lists all webhook subscriptions for the authenticated project with pagination. Currently limited to one subscription per project."
        },
        {
          "info": {
            "name": "Create webhook subscription",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://backend.composio.dev/api/v3/webhook_subscriptions",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Creates a webhook subscription for the authenticated project. Only one subscription is allowed per project. The signing secret is returned in subscription responses."
        },
        {
          "info": {
            "name": "Get webhook subscription",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://backend.composio.dev/api/v3/webhook_subscriptions/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Webhook subscription ID"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Retrieves a webhook subscription by ID."
        },
        {
          "info": {
            "name": "Update webhook subscription",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://backend.composio.dev/api/v3/webhook_subscriptions/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Webhook subscription ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Updates a webhook subscription. At least one field must be provided."
        },
        {
          "info": {
            "name": "Delete webhook subscription",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://backend.composio.dev/api/v3/webhook_subscriptions/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Webhook subscription ID"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Permanently deletes a webhook subscription. This action cannot be undone."
        },
        {
          "info": {
            "name": "Rotate webhook secret",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://backend.composio.dev/api/v3/webhook_subscriptions/:id/rotate_secret",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Webhook subscription ID"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Generates a new signing secret for the webhook subscription."
        },
        {
          "info": {
            "name": "List available event types",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://backend.composio.dev/api/v3/webhook_subscriptions/event_types",
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Returns all event types that can be subscribed to, along with their supported webhook versions."
        }
      ]
    }
  ],
  "bundled": true
}