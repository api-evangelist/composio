{
  "opencollection": "1.0.0",
  "info": {
    "name": "Composio Platform Account Management Applications API",
    "version": "3.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Applications",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List MCP servers for a specific app",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://backend.composio.dev/api/v3/mcp/app/:appKey",
            "params": [
              {
                "name": "appKey",
                "value": "",
                "type": "path",
                "description": "The key of the app to find MCP servers for"
              },
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "Filter MCP servers by name (case-insensitive partial match)"
              },
              {
                "name": "toolkits",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of toolkit slugs to filter servers by"
              },
              {
                "name": "auth_config_ids",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of auth config IDs to filter servers by"
              },
              {
                "name": "order_by",
                "value": "",
                "type": "query",
                "description": "Field to order results by"
              },
              {
                "name": "order_direction",
                "value": "",
                "type": "query",
                "description": "Direction of ordering"
              },
              {
                "name": "page_no",
                "value": "",
                "type": "query",
                "description": "Page number for pagination (1-based)"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of items per page (default: 10)"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Retrieves a paginated list of Model Control Protocol (MCP) servers that are configured for a specific application or toolkit. This endpoint allows you to find all MCP server instances that have access to a particular application, such as GitHub, Slack, or Jira."
        }
      ]
    }
  ],
  "bundled": true
}