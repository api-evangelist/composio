                  "key": "uuid",
                  "value": "<uuid>",
                  "description": "(Required) The legacy UUID that needs to be converted to a NanoId"
                },
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "(Required) The type of resource that the UUID belongs to"
