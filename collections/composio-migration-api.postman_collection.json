          "name": "Get NanoId from UUID",
          "request": {
            "name": "Get NanoId from UUID",
            "description": {
              "content": "Convert a legacy UUID to its corresponding NanoId for migration purposes. This endpoint facilitates the transition from UUID-based identifiers to the more compact NanoId format used in the v3 API.",
              "type": "text/plain"
            },
