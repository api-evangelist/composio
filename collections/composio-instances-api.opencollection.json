{
  "opencollection": "1.0.0",
  "info": {
    "name": "Composio Platform Account Management Instances API",
    "version": "3.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Instances",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all instances for an MCP server",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://backend.composio.dev/api/v3/mcp/servers/:serverId/instances",
            "params": [
              {
                "name": "serverId",
                "value": "",
                "type": "path",
                "description": "The ID of the MCP server"
              },
              {
                "name": "page_no",
                "value": "",
                "type": "query",
                "description": "Page number for pagination (1-based)"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of items per page (default: 20)"
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "Search instances by user ID/instance ID"
              },
              {
                "name": "order_by",
                "value": "",
                "type": "query",
                "description": "Field to order results by"
              },
              {
                "name": "order_direction",
                "value": "",
                "type": "query",
                "description": "Direction of ordering"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Retrieves a paginated list of user instances (user IDs) associated with a specific Model Control Protocol (MCP) server. This endpoint supports pagination to handle servers with many instances."
        },
        {
          "info": {
            "name": "Create a new MCP server instance",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://backend.composio.dev/api/v3/mcp/servers/:serverId/instances",
            "params": [
              {
                "name": "serverId",
                "value": "",
                "type": "path",
                "description": "The ID of the MCP server"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Creates a new instance for a Model Control Protocol (MCP) server. This endpoint validates that the user has connected accounts for all auth configurations associated with the MCP server before creating the instance."
        },
        {
          "info": {
            "name": "Delete an MCP server instance and associated connected accounts",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://backend.composio.dev/api/v3/mcp/servers/:serverId/instances/:instanceId",
            "params": [
              {
                "name": "serverId",
                "value": "",
                "type": "path",
                "description": "The ID of the MCP server"
              },
              {
                "name": "instanceId",
                "value": "",
                "type": "path",
                "description": "The instance ID (user ID) to delete"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Removes a user instance from the MCP server and deletes all connected accounts for that user that are associated with the auth configurations of this specific MCP server. Connected accounts for other auth configurations are not affected."
        }
      ]
    }
  ],
  "bundled": true
}