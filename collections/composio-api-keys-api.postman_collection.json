          "id": "fa98ecbb-b953-4cfd-88d5-cc45926f81a1",
          "name": "Delete and generate new API key for project",
          "request": {
            "name": "Delete and generate new API key for project",
            "description": {
              "content": "Generates a new API key for the specified project, invalidating any existing API keys for that project. This operation creates a fresh API key with a new random name and key value. All existing API keys for this project will be marked as deleted.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v3",
                "org",
                "owner",
                "project",
                ":nano_id",
                "regenerate_api_key"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<projectId>",
                  "key": "nano_id",
                  "description": "(Required) Unique identifier (Nano ID) of the project to regenerate API key for"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "x-org-api-key"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
          },
