{
  "opencollection": "1.0.0",
  "info": {
    "name": "Composio Platform Account Management Proxy API",
    "version": "3.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Proxy",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Execute proxy request",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://backend.composio.dev/api/v3/tools/execute/proxy",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Proxy an HTTP request to a third-party API using connected account credentials. This endpoint allows making authenticated API calls to external services while abstracting away authentication details."
        }
      ]
    }
  ],
  "bundled": true
}