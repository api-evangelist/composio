                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "uuid",
                "value": "",
                "type": "query",
                "description": "The legacy UUID that needs to be converted to a NanoId"
              },
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "The type of resource that the UUID belongs to"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "x-api-key",
              "value": "{{x-api-key}}",
              "placement": "header"
            }
          },
          "docs": "Convert a legacy UUID to its corresponding NanoId for migration purposes. This endpoint facilitates the transition from UUID-based identifiers to the more compact NanoId format used in the v3 API."
