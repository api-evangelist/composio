      "item": [
        {
          "id": "6d74c2e2-486e-47a1-ae63-a00562fe2b59",
          "name": "List MCP servers for a specific app",
          "request": {
            "name": "List MCP servers for a specific app",
            "description": {
              "content": "Retrieves a paginated list of Model Control Protocol (MCP) servers that are configured for a specific application or toolkit. This endpoint allows you to find all MCP server instances that have access to a particular application, such as GitHub, Slack, or Jira.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v3",
                "mcp",
                "app",
                ":appKey"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "name",
                  "value": "<string>",
                  "description": "Filter MCP servers by name (case-insensitive partial match)"
                },
                {
                  "disabled": false,
                  "key": "toolkits",
                  "value": "<string>",
                  "description": "Comma-separated list of toolkit slugs to filter servers by"
                },
                {
                  "disabled": false,
                  "key": "auth_config_ids",
                  "value": "<string>",
                  "description": "Comma-separated list of auth config IDs to filter servers by"
                },
                {
                  "disabled": false,
                  "key": "order_by",
                  "value": "updated_at",
                  "description": "Field to order results by"
                },
                {
                  "disabled": false,
                  "key": "order_direction",
                  "value": "desc",
                  "description": "Direction of ordering"
                },
                {
                  "disabled": false,
                  "key": "page_no",
                  "value": "1",
                  "description": "Page number for pagination (1-based)"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "10",
                  "description": "Number of items per page (default: 10)"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "appKey",
                  "description": "(Required) The key of the app to find MCP servers for"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "x-api-key"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
          },
